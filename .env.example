NEXT_PUBLIC_SUPABASE_URL=..
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=..
# Server only; required for private Storage uploads. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=..
SUPABASE_DOCUMENT_BUCKET=enterprise-documents
# DATABASE_URL=..
DATABASE_URL=..
GROQ_API_KEY=..
GROQ_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DOCUMENT_CHUNKING_STRATEGY=sentence
EMBEDDING_MAX_SEQUENCE_LENGTH=512
# Demo RBAC accounts. Set unique passwords and a random AUTH_SECRET_KEY (32+ characters).
AUTH_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
AUTH_COOKIE_SECURE=false
DEMO_VIEWER_USERNAME=viewer
DEMO_VIEWER_PASSWORD=replace-this-password
DEMO_ANALYST_USERNAME=analyst
DEMO_ANALYST_PASSWORD=replace-this-password
DEMO_SUSTAINABILITY_ANALYST_USERNAME=sustainability
DEMO_SUSTAINABILITY_ANALYST_PASSWORD=replace-this-password
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=replace-this-password
DEMO_UPLOADER_USERNAME=uploader
DEMO_UPLOADER_PASSWORD=replace-this-password
