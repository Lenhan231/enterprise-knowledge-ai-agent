NEXT_PUBLIC_SUPABASE_URL=..
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=..
# Kho tài liệu/RAG hiện có.
DATABASE_URL=..
# Bắt buộc cho analytics: login chỉ đọc được cấp role commerce_analytics_reader.
ANALYTICS_DATABASE_URL=..
# Local browser testing only. Production must inject a verified identity from
# your authentication middleware instead of enabling these settings.
# APP_ENV=development
# ALLOW_DEV_ANALYTICS=true
# DEV_ANALYTICS_IDENTITY=local-analyst
GROQ_API_KEY=..
GROQ_API_KEY_2=..
GROQ_API_KEY_RAGAS=..
GROQ_MODEL=qwen/qwen3.8-27b
RAGAS_JUDGE_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=..
## Optional Cloudflare Workers AI provider
CLOUDFLARE_ACCOUNT_ID=..
CLOUDFLARE_API_TOKEN=..
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Existing MiniLM installations must migrate document_chunks to E5 before switching this setting.
