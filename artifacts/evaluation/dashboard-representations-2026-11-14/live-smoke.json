        "sql": "SELECT p.category AS category, AVG(r.rating) AS rating, COUNT(DISTINCT r.review_id) AS review_count FROM commerce.reviews AS r JOIN commerce.products AS p ON r.product_id = p.product_id WHERE r.review_date >= CAST($1 AS DATE) AND r.review_date < CAST($2 AS DATE) GROUP BY p.category ORDER BY 1 LIMIT 200",
