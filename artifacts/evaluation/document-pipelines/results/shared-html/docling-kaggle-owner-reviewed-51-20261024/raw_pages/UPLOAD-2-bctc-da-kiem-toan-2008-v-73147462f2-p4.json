], "content_layer": "body", "label": "text", "prov": [{"page_no": 1, "bbox": {"l": 112.33333333333333, "t": 1167.1754780652418, "r": 441.6666666666667, "b": 1150.1754780652418, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 41]}], "orig": "BAO CAO CUA HỘI ĐÔNG QUAN TRI (tiếp theo)", "text": "BAO CAO CUA HỘI ĐÔNG QUAN TRI (tiếp theo)"}, {"self_ref": "#/texts/3", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "section_header", "prov": [{"page_no": 1, "bbox": {"l": 112.33333333333333, "t": 1115.8421447319085, "r": 746.3333333333334, "b": 1098.1754780652418, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 72]}], "orig": "CÔNG BÓ TRÁCH NHIỆM CỦA BAN GIÁM ĐÓC ĐÓI VỚI CÁC BÁO CÁO TÀI CHÍNH RIÊNG", "text": "CÔNG BÓ TRÁCH NHIỆM CỦA BAN GIÁM ĐÓC ĐÓI VỚI CÁC BÁO CÁO TÀI CHÍNH RIÊNG", "level": 1}, {"self_ref": "#/texts/4", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "text", "prov": [{"page_no": 1, "bbox": {"l": 112.0, "t": 1080.8421447319085, "r": 777.3333333333334, "b": 1029.1754780652418, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 287]}], "orig": "Ban Giám đốc chịu trách nhiệm đảm bảo các báo cáo tài chính cho từng năm tài chính phản ánh trung thực và hợp lý tình hình hoạt động, kết quả hoạt động kinh doanh và tình hình lưu chuyển tiền tệ của Công ty trong năm. Trong quá trình lập các báo cáo tài chính này, Ban Giám đốc cần phải:", "text": "Ban Giám đốc chịu trách nhiệm đảm bảo các báo cáo tài chính cho từng năm tài chính phản ánh trung thực và hợp lý tình hình hoạt động, kết quả hoạt động kinh doanh và tình hình lưu chuyển tiền tệ của Công ty trong năm. Trong quá trình lập các báo cáo tài chính này, Ban Giám đốc cần phải:"}, {"self_ref": "#/texts/5", "parent": {"$ref": "#/groups/0"}, "children": [], "content_layer": "body", "label": "list_item", "prov": [{"page_no": 1, "bbox": {"l": 112.33333333333333, "t": 1019.1754780652418, "r": 763.3333333333334, "b": 1001.8421447319085, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 93]}], "orig": "e lựa chọn các chính sách kế toán thích hợp và áp dụng các chính sách này một cách nhất quan;", "text": "e lựa chọn các chính sách kế toán thích hợp và áp dụng các chính sách này một cách nhất quan;", "enumerated": false, "marker": ""}, {"self_ref": "#/texts/6", "parent": {"$ref": "#/groups/0"}, "children": [], "content_layer": "body", "label": "list_item", "prov": [{"page_no": 1, "bbox": {"l": 112.33333333333333, "t": 990.5088113985752, "r": 567.6666666666667, "b": 973.1754780652419, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 69]}], "orig": "e _ thực hiện các đánh giá và ước tính một cách hợp lý và thận trọng;", "text": "e _ thực hiện các đánh giá và ước tính một cách hợp lý và thận trọng;", "enumerated": false, "marker": ""}, {"self_ref": "#/texts/7", "parent": {"$ref": "#/groups/0"}, "children": [], "content_layer": "body", "label": "list_item", "prov": [{"page_no": 1, "bbox": {"l": 112.66666666666667, "t": 964.5088113985752, "r": 777.6666666666666, "b": 914.5088113985752, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 203]}], "orig": "e nêu rõ các chuẩn mực kế toán áp dụng cho Công ty có được tuân thủ hay không và tất cả những sai lệch trọng yếu so với những chuẩn mực này đã được trình bày và giải thích trong các báo cáo tài chính; và", "text": "e nêu rõ các chuẩn mực kế toán áp dụng cho Công ty có được tuân thủ hay không và tất cả những sai lệch trọng yếu so với những chuẩn mực này đã được trình bày và giải thích trong các báo cáo tài chính; và", "enumerated": false, "marker": ""}, {"self_ref": "#/texts/8", "parent": {"$ref": "#/groups/0"}, "children": [], "content_layer": "body", "label": "list_item", "prov": [{"page_no": 1, "bbox": {"l": 113.0, "t": 902.8421447319085, "r": 777.3333333333334, "b": 868.8421447319085, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 133]}], "orig": "e lập các báo cáo tài chính trên cơ sở nguyên tắc hoạt động liên tục trừ trường hợp không thé cho rằng Công ty sẽ tiếp tục hoạt động.", "text": "e lập các báo cáo tài chính trên cơ sở nguyên tắc hoạt động liên tục trừ trường hợp không thé cho rằng Công ty sẽ tiếp tục hoạt động.", "enumerated": false, "marker": ""}, {"self_ref": "#/texts/9", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "text", "prov": [{"page_no": 1, "bbox": {"l": 113.66666666666667, "t": 851.8421447319085, "r": 777.0, "b": 817.8421447319085, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 112]}], "orig": "Ban Giám đốc cam kết rằng Công ty đã tuân thủ những yêu cầu nêu trên trong việc lập các báo cáo tài chính riêng.", "text": "Ban Giám đốc cam kết rằng Công ty đã tuân thủ những yêu cầu nêu trên trong việc lập các báo cáo tài chính riêng."}, {"self_ref": "#/texts/10", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "text", "prov": [{"page_no": 1, "bbox": {"l": 114.0, "t": 800.5088113985753, "r": 776.6666666666666, "b": 715.1754780652418, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 460]}], "orig": "Ban Giám đốc chịu trách nhiệm đảm bảo việc các số sách kế toán thích hợp được lưu giữ để phản ánh tình hình tài chính của Công ty, với mức độ chính xác hợp lý, tại bat kỳ thời điểm nào và đảm bảo rằng các số sách kế toán tuân thủ với hệ thống kế toán đã được đăng ký. Ban Giám đốc cũng chịu trách nhiệm về việc quản lý các tài sản của Công ty và do đó phải thực hiện các biện pháp thích hợp để ngăn chặn va phát hiện các hành vi gian lận và những vi phạm khác.", "text": "Ban Giám đốc chịu trách nhiệm đảm bảo việc các số sách kế toán thích hợp được lưu giữ để phản ánh tình hình tài chính của Công ty, với mức độ chính xác hợp lý, tại bat kỳ thời điểm nào và đảm bảo rằng các số sách kế toán tuân thủ với hệ thống kế toán đã được đăng ký. Ban Giám đốc cũng chịu trách nhiệm về việc quản lý các tài sản của Công ty và do đó phải thực hiện các biện pháp thích hợp để ngăn chặn va phát hiện các hành vi gian lận và những vi phạm khác."}, {"self_ref": "#/texts/11", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "section_header", "prov": [{"page_no": 1, "bbox": {"l": 114.33333333333333, "t": 680.8421447319085, "r": 385.0, "b": 663.5088113985752, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 31]}], "orig": "PHÊ DUYỆT CÁC BÁO CÁO TÀI CHÍNH", "text": "PHÊ DUYỆT CÁC BÁO CÁO TÀI CHÍNH", "level": 1}, {"self_ref": "#/texts/12", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "text", "prov": [{"page_no": 1, "bbox": {"l": 113.0, "t": 643.8421447319085, "r": 776.0, "b": 576.8421447319085, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 350]}], "orig": "Chúng tôi phê duyệt các báo cáo tài chính riêng kèm theo. Các báo cáo này phản ánh trung thực và hợp lý tình hình tài chính của Công ty vào ngày 31 tháng 12 năm 2008, kết quả hoạt \"4 kinh doanh và tinh hình lưu chuyển tiền tệ cho năm kết thúc cùng ngày phù hợp với Chuẩn mực Kế toán và Hệ thống Ké toán Việt Nam và tuân thủ các quy định có liên quan.", "text": "Chúng tôi phê duyệt các báo cáo tài chính riêng kèm theo. Các báo cáo này phản ánh trung thực và hợp lý tình hình tài chính của Công ty vào ngày 31 tháng 12 năm 2008, kết quả hoạt \"4 kinh doanh và tinh hình lưu chuyển tiền tệ cho năm kết thúc cùng ngày phù hợp với Chuẩn mực Kế toán và Hệ thống Ké toán Việt Nam và tuân thủ các quy định có liên quan."}, {"self_ref": "#/texts/13", "parent": {"$ref": "#/pictures/0"}, "children": [], "content_layer": "body", "label": "caption", "prov": [{"page_no": 1, "bbox": {"l": 113.0, "t": 352.1754780652419, "r": 290.33333333333337, "b": 337.5088113985752, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 24]}], "orig": "Ngày 12 tháng 3 năm 2009", "text": "Ngày 12 tháng 3 năm 2009"}, {"self_ref": "#/texts/14", "parent": {"$ref": "#/pictures/0"}, "children": [], "content_layer": "body", "label": "text", "prov": [{"page_no": 1, "bbox": {"l": 99.66666666666666, "t": 542.5088113985752, "r": 297.66666666666663, "b": 492.5088113985752, "coord_origin": "BOTTOMLEFT"}, "charspan": 