66666667, "b": 845.5088113985753, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 58]}], "orig": "CÁC SỰ KIỆN SAU NGÀY KHÓA SÓ KẾ TOÁN LẬP BÁO CÁO TÀI CHÍNH", "text": "CÁC SỰ KIỆN SAU NGÀY KHÓA SÓ KẾ TOÁN LẬP BÁO CÁO TÀI CHÍNH", "level": 1}, {"self_ref": "#/texts/7", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "text", "prov": [{"page_no": 1, "bbox": {"l": 156.33333333333334, "t": 829.1754780652418, "r": 718.6666666666666, "b": 779.5088113985753, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 182]}], "orig": "Không có phát sinh bất kỳ sự kiện nào có thể ảnh hưởng đến các thông tín đã được trình bày trong Báo cáo tài chính cũng như có hoặc có thể tác động đảng kể đến hoạt động của Công ty,", "text": "Không có phát sinh bất kỳ sự kiện nào có thể ảnh hưởng đến các thông tín đã được trình bày trong Báo cáo tài chính cũng như có hoặc có thể tác động đảng kể đến hoạt động của Công ty,"}, {"self_ref": "#/texts/8", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "section_header", "prov": [{"page_no": 1, "bbox": {"l": 157.33333333333334, "t": 741.8421447319085, "r": 280.66666666666663, "b": 717.8421447319085, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 14]}], "orig": "KIỂM TOÁN VIÊN", "text": "KIỂM TOÁN VIÊN", "level": 1}, {"self_ref": "#/texts/9", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "text", "prov": [{"page_no": 1, "bbox": {"l": 155.33333333333334, "t": 717.1754780652419, "r": 719.6666666666666, "b": 662.5088113985752, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 163]}], "orig": "Công ty TNHH Dịch vụ Tư vấn Tài chính Kế toán và Kiểm toán (A ASC) đã thực hiện kiểm toán Báo cáo tài chính cho năm tài chính kết thúc ngày 31/12/2009 của Công ty.", "text": "Công ty TNHH Dịch vụ Tư vấn Tài chính Kế toán và Kiểm toán (A ASC) đã thực hiện kiểm toán Báo cáo tài chính cho năm tài chính kết thúc ngày 31/12/2009 của Công ty."}, {"self_ref": "#/texts/10", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "section_header", "prov": [{"page_no": 1, "bbox": {"l": 158.66666666666666, "t": 638.8421447319085, "r": 675.0, "b": 615.5088113985752, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 62]}], "orig": "CÔNG BÓ TRÁCH NHIỆM CỦA BAN GIÁM ĐÓC ĐÓI VỚI BÁO CÁO TÀI CHÍNH", "text": "CÔNG BÓ TRÁCH NHIỆM CỦA BAN GIÁM ĐÓC ĐÓI VỚI BÁO CÁO TÀI CHÍNH", "level": 1}, {"self_ref": "#/texts/11", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "text", "prov": [{"page_no": 1, "bbox": {"l": 157.0, "t": 604.8421447319085, "r": 717.6666666666666, "b": 534.1754780652419, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 304]}], "orig": "Ban Giám đốc Công ty chịu trách nhiệm về việc lập Báo cáo tài chính phản ánh trung thực, hợp lý tình hình hoạt động, kết quả hoạt động kinh doanh và tình hình lưu chuyển tiền tệ của Công ty trong kỳ, Trong thi thi quá trình lập Báo cáo tài chính, Ban Giám đốc Công ty cam kết đã tuân thủ các yêu cầu sau:", "text": "Ban Giám đốc Công ty chịu trách nhiệm về việc lập Báo cáo tài chính phản ánh trung thực, hợp lý tình hình hoạt động, kết quả hoạt động kinh doanh và tình hình lưu chuyển tiền tệ của Công ty trong kỳ, Trong thi thi quá trình lập Báo cáo tài chính, Ban Giám đốc Công ty cam kết đã tuân thủ các yêu cầu sau:"}, {"self_ref": "#/texts/12", "parent": {"$ref": "#/groups/1"}, "children": [], "content_layer": "body", "label": "list_item", "prov": [{"page_no": 1, "bbox": {"l": 188.0, "t": 522.5088113985752, "r": 707.0, "b": 501.84214473190855, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 91]}], "orig": "Lựa chọn các chính sách kế toán thích hợp và áp dụng các chính sách này một cách nhất quán;", "text": "Lựa chọn các chính sách kế toán thích hợp và áp dụng các chính sách này một cách nhất quán;", "enumerated": false, "marker": ""}, {"self_ref": "#/texts/13", "parent": {"$ref": "#/groups/1"}, "children": [], "content_layer": "body", "label": "list_item", "prov": [{"page_no": 1, "bbox": {"l": 189.0, "t": 490.5088113985752, "r": 482.3333333333333, "b": 467.1754780652419, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 52]}], "orig": "Đưa ra các đánh giá và dự đoán hợp lý và thận trọng;", "text": "Đưa ra các đánh giá và dự đoán hợp lý và thận trọng;", "enumerated": false, "marker": ""}, {"self_ref": "#/texts/14", "parent": {"$ref": "#/groups/1"}, "children": [], "content_layer": "body", "label": "list_item", "prov": [{"page_no": 1, "bbox": {"l": 188.0, "t": 457.84214473190855, "r": 717.3333333333334, "b": 410.5088113985752, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 185]}], "orig": "Nêu rõ các chuẩn mực kể toán được áp dụng có được tuân thủ hay không, có những áp dụng sai lệ hệ lệch trọng yếu đến mức cần phải công bố và giải thích trong báo cáo tài chính hay không;", "text": "Nêu rõ các chuẩn mực kể toán được áp dụng có được tuân thủ hay không, có những áp dụng sai lệ hệ lệch trọng yếu đến mức cần phải công bố và giải thích trong báo cáo tài chính hay không;", "enumerated": false, "marker": ""}, {"self_ref": "#/texts/15", "parent": {"$ref": "#/groups/1"}, "children": [], "content_layer": "body", "label": "list_item", "prov": [{"page_no": 1, "bbox": {"l": 188.66666666666666, "t": 400.84214473190855, "r": 717.3333333333334, "b": 353.5088113985753, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 136]}], "orig": "Lập và trình bày các báo cáo tài chính trên cơ sở tuân thủ các chuẩn mực kế toán, chế độ kế toán và các quy định có liên quan hiện hành;", "text": "Lập và trình bày các báo cáo tài chính trên cơ sở tuân thủ các chuẩn mực kế toán, chế độ kế toán và các quy định có liên quan hiện hành;", "enumerated": false, "marker": ""}, {"self_ref": "#/texts/16", "parent": {"$ref": "#/groups/1"}, "children": [], "content_layer": "body", "label": "list_item", "prov": [{"page_no": 1, "bbox": {"l": 189.0, "t": 341.5088113985753, "r": 716.6666666666666, "b": 295.84214473190855, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 147]}], "orig": "Lập các báo cáo tài chính dựa trên cơ sở hoạt động kinh doanh liên tục, trừ trường hợp không thể cho rằng Công ty sẽ tiếp tục hoạt động kinh doanh.", "text": "Lập các báo cáo tài chính dựa trên cơ sở hoạt động kinh doanh liên tục, trừ trường hợp không thể cho rằng Công ty sẽ tiếp tục hoạt động kinh doanh.", "enumerated": false, "marker": ""}, {"self_ref": "#/texts/17", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "text", "prov": [{"page_no": 1, "bbox": {"l": 157.33333333333334, "t": 286.5088113985753, "r": 717.6666666666666, "b": 167.5088113985753, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 428]}], "orig": "Ban Giám đốc Công ty đảm bảo rằng các sổ kế toán được lưu giữ để phản ánh tình hình tài chính của Công ty, với mức độ trung thực, hợp lý tại bắt cứ thời điềm nào và dàm bảo rằng Báo cáo tài chính theng trêng tuân thù các quy định hiện hành của Nhà nước, Đồng thời có trách nhiệm trong việc bảo đảm an toàn tài sản của Công ty và thực hiện các biện pháp thích hợp để ngăn chặn, phát hiện các hành vi gian lận và các vi phạm khác.", "text": "Ban Giám đốc Công ty đảm bảo rằng các sổ kế toán được lưu giữ để phản ánh tình hình tài chính của Công ty, với mức độ trung thực, hợp lý tại bắt cứ thời điềm nào và dàm bảo rằng Báo cáo tài chính theng trêng tuân thù các quy định hiện hành của Nhà nước, Đồng thời có trách nhiệm trong việc bảo đảm an toàn tài sản của Công ty và thực hiện các biện pháp thích hợp để ngăn chặn, phát hiện các hành vi gian lận và các vi phạm khác."}, {"self_ref": "#/texts/18", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "furniture", "label": "page_footer", "prov": [{"page_no": 1, "bbox": {"l": 732.6666666666666, "t": 36.84214473190855, "r": 793.0, "b": 20.50881139857529, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 7]}], "orig": "Trona E", "text": "Trona E"}], "pictures": [{"self_ref": "#/pictures/0", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "picture", "prov": [{"pa