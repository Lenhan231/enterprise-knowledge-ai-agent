/texts/3", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "text", "prov": [{"page_no": 1, "bbox": {"l": 109.66666666666667, "t": 1177.5088113985753, "r": 540.6666666666667, "b": 1130.8421447319085, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 107]}], "orig": "THUYẾT MINH BÁO CÁO TÀI CHÍNH RIÊNG (TIẾP THEO) vào ngày 31 tháng 12 năm 2008 và cho năm kết thúc cùng ngày", "text": "THUYẾT MINH BÁO CÁO TÀI CHÍNH RIÊNG (TIẾP THEO) vào ngày 31 tháng 12 năm 2008 và cho năm kết thúc cùng ngày"}, {"self_ref": "#/texts/4", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "section_header", "prov": [{"page_no": 1, "bbox": {"l": 110.66666666666667, "t": 1109.1754780652418, "r": 601.0, "b": 1074.5088113985753, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 56]}], "orig": "THUẾ THU NHẬP DOANH NGHIỆP (THUẾ 'TNDN?) (tiếp theo) 17.", "text": "THUẾ THU NHẬP DOANH NGHIỆP (THUẾ 'TNDN?) (tiếp theo) 17.", "level": 1}, {"self_ref": "#/texts/5", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "section_header", "prov": [{"page_no": 1, "bbox": {"l": 111.66935475667317, "t": 1057.500626329809, "r": 448.7338460286458, "b": 1035.3577697319085, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 41]}], "orig": "17.2 Thuế thu nhập doanh nghiệp hiện hành", "text": "17.2 Thuế thu nhập doanh nghiệp hiện hành", "level": 1}, {"self_ref": "#/texts/6", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "text", "prov": [{"page_no": 1, "bbox": {"l": 164.03225708007812, "t": 1022.5564289929763, "r": 784.0644938151041, "b": 899.3867817761794, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 567]}], "orig": "Thuế thu nhập doanh nghiệp hiện hành phải trả được xác định dựa trên thu nhập chịu thuế của năm hiện tại. Thu nhập chịu thuế khác với thu nhập được báo cáo trong báo cáo kết quả sản xuất kinh doanh vì thu nhập chịu thuế không bao gồm các khoản mục thu nhập chịu thuế hay chi phí được khấu trừ cho mục đích tính thuế trong các năm khác và cũng không bao gồm các khoản mục không phải chịu thuế hay không được khấu trừ cho mục đích tính thuế, Thuế thu nhập doanh nghiệp hiện hành phải trả của Công ty được tính theo thuế suất đã ban hành đến ngày kết thúc năm tài chính.", "text": "Thuế thu nhập doanh nghiệp hiện hành phải trả được xác định dựa trên thu nhập chịu thuế của năm hiện tại. Thu nhập chịu thuế khác với thu nhập được báo cáo trong báo cáo kết quả sản xuất kinh doanh vì thu nhập chịu thuế không bao gồm các khoản mục thu nhập chịu thuế hay chi phí được khấu trừ cho mục đích tính thuế trong các năm khác và cũng không bao gồm các khoản mục không phải chịu thuế hay không được khấu trừ cho mục đích tính thuế, Thuế thu nhập doanh nghiệp hiện hành phải trả của Công ty được tính theo thuế suất đã ban hành đến ngày kết thúc năm tài chính."}, {"self_ref": "#/texts/7", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "section_header", "prov": [{"page_no": 1, "bbox": {"l": 111.28629048665364, "t": 434.3140202405349, "r": 435.1421305338542, "b": 410.70308375778745, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 40]}], "orig": "17.3 Thuế thu nhập doanh nghiệp hoãn lại", "text": "17.3 Thuế thu nhập doanh nghiệp hoãn lại", "level": 1}, {"self_ref": "#/texts/8", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "furniture", "label": "page_footer", "prov": [{"page_no": 1, "bbox": {"l": 434.3333333333333, "t": 64.1754780652418, "r": 457.6666666666667, "b": 44.84214473190855, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 2]}], "orig": "18", "text": "18"}], "pictures": [], "tables": [{"self_ref": "#/tables/0", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "table", "prov": [{"page_no": 1, "bbox": {"l": 165.30286662035286, "t": 883.3126511041589, "r": 781.1540576451753, "b": 456.795744770185, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 0]}], "captions": [], "references": [], "footnotes": [], "d