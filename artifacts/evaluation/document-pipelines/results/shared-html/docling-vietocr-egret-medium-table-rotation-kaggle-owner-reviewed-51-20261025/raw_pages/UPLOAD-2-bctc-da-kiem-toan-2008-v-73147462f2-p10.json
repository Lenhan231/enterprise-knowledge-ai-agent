09, "b": 951.3382384819085, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 8]}], "orig": "Ngày cấp", "text": "Ngày cấp"}, {"self_ref": "#/texts/6", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "text", "prov": [{"page_no": 1, "bbox": {"l": 161.3790283203125, "t": 843.9798400444085, "r": 778.9838460286459, "b": 805.8079650444085, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 122]}], "orig": "Hoạt động chính của Công ty là xây dựng cơ sở hạ tầng cho khu công nghiệp và cho thuê lại đất đã phát triển cơ sở hạ tầng.", "text": "Hoạt động chính của Công ty là xây dựng cơ sở hạ tầng cho khu công nghiệp và cho thuê lại đất đã phát triển cơ sở hạ tầng."}, {"self_ref": "#/texts/7", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "text", "prov": [{"page_no": 1, "bbox": {"l": 162.41935221354166, "t": 792.8567931694085, "r": 657.9596761067709, "b": 770.7034728569085, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 71]}], "orig": "Công ty có trụ sở chính tại Xã Long Hậu, Huyện Cần Giuộc, Tỉnh Long An.", "text": "Công ty có trụ sở chính tại Xã Long Hậu, Huyện Cần Giuộc, Tỉnh Long An."}, {"self_ref": "#/texts/8", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "section_header", "prov": [{"page_no": 1, "bbox": {"l": 108.66935475667317, "t": 741.2023144605056, "r": 509.8870849609375, "b": 720.8898157320713, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 41]}], "orig": "2. TÓM TẤT CÁC CHÍNH SÁCH KẾ TOÁN CHỦ YẾU", "text": "2. TÓM TẤT CÁC CHÍNH SÁCH KẾ TOÁN CHỦ YẾU", "level": 1}, {"self_ref": "#/texts/9", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "text", "prov": [{"page_no": 1, "bbox": {"l": 162.07257588704428, "t": 706.4300709607497, "r": 778.290283203125, "b": 652.378165646622, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 186]}], "orig": "Các báo cáo tài chính của Công ty được trình bày bằng ngàn đồng Việt Nam (\"Ngàn VNĐ\") phù hợp với Hệ thống Kế t