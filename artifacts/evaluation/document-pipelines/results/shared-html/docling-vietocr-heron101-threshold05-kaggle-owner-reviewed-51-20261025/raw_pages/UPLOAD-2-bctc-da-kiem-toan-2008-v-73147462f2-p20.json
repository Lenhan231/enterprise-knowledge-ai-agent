tent_layer": "body", "label": "section_header", "prov": [{"page_no": 1, "bbox": {"l": 111.33333333333333, "t": 1105.5088113985753, "r": 598.6666666666667, "b": 1077.1754780652418, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 56]}], "orig": "THUẾ THU NHẬP DOANH NGHIỆP (THUẾ ?TNDN?) (tiếp theo) 17.", "text": "THUẾ THU NHẬP DOANH NGHIỆP (THUẾ ?TNDN?) (tiếp theo) 17.", "level": 1}, {"self_ref": "#/texts/4", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "section_header", "prov": [{"page_no": 1, "bbox": {"l": 111.67338689168294, "t": 1057.289689465592, "r": 448.9536539713542, "b": 1035.5631276013746, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 36]}], "orig": "17.2 Thuế thu nhập doanh nghiện hành", "text": "17.2 Thuế thu nhập doanh nghiện hành", "level": 1}, {"self_ref": "#/texts/5", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "text", "prov": [{"page_no": 1, "bbox": {"l": 163.64314778645834, "t": 1022.4582157971755, "r": 783.7923583984375, "b": 899.3410257540439, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 567]}], "orig": "Thuế thu nhập doanh nghiệp hiện hành phải trả được xác định dựa trên thu nhập chịu thuế của năm hiện tại. Thu nhập chịu thuế khác với thu nhập được báo cáo trong báo cáo kết quả sản xuất kinh doanh vì thu nhập chịu thuế không bao gồm các khoản mục thu nhập chịu thuế hay chi phí được khấu trừ cho mục đích tính thuế trong các năm khác và cũng không bao gồm các khoản mục không phải chịu thuế hay không được khấu trừ cho mục đích tính thuế, Thuế thu nhập doanh nghiệp hiện hành phải trả của Công ty được tính theo thuế suất đã ban hành đến ngày kết thúc năm tài chính.", "text": "Thuế thu nhập doanh nghiệp hiện hành phải trả được xác định dựa trên thu nhập chịu thuế của năm hiện tại. Thu nhập chịu thuế khác với thu nhập được báo cáo trong báo cáo kết quả sản xuất kinh doanh vì thu nhập chịu thuế không bao gồm các khoản mục thu nhập chịu thuế hay chi phí được khấu trừ cho mục đích tính thuế trong các năm khác và cũng không bao gồm các khoản mục không phải chịu thuế hay không được khấu trừ cho mục đích tính thuế, Thuế thu nhập doanh nghiệp hiện hành phải trả của Công ty được tính theo thuế suất đã ban hành đến ngày kết thúc năm tài chính."}, {"self_ref": "#/texts/6", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "section_header", "prov": [{"page_no": 1, "bbox": {"l": 111.62903213500977, "t": 434.39214460475193, "r": 435.1693522135417, "b": 410.5483952405349, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 40]}], "orig": "17.3 Thuế thu nhập doanh nghiệp hoãn lại", "text": "17.3 Thuế thu nhập doanh nghiệp hoãn lại", "level": 1}, {"self_ref": "#/texts/7", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "furniture", "label": "page_footer", "prov": [{"page_no": 1, "bbox": {"l": 434.6666666666667, "t": 64.1754780652418, "r": 457.3333333333333, "b": 44.84214473190855, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 2]}], "orig": "18", "text": "18"}], "pictures": [], "tables": [{"self_ref": "#/tables/0", "parent": {"$ref": "#/body"}, "children": [], "content_layer": "body", "label": "table", "prov": [{"page_no": 1, "bbox": {"l": 165.8488653988078, "t": 883.6968193917166, "r": 784.3995499787408, "b": 455.85634803462074, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 0]}], "captions": [], "references": [], "footnotes": [], "data": {"table_cells": [{"bbox": {"l": 706.0121256510416, "t": 379.36494954427087, "r": 782.0483805338541, "b": 418.3348185221354, "coord_origin": "TOPLEFT"}, "row_span": 1, "col_span": 1, "start_row_offset_idx": 0, "end_row_offset_idx": 1, "start_col_offset_idx": 2, "end_col_offset_idx": 3, "text": "Ngàn VNĐ Năm trước", "column_header": true, "row_header": false, "row_section": false, "fillable": false}, {"bbox": {"l": 591.60888671875, "t": 400.74666341145837, "r": 657.5302327473959, "b": 420.40401204427087, "coord_origin": "TOPLEFT"}, "row_span": 1, "col_span": 1, "start_row_offset_idx": 0,