{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engine-neutral end-to-end page prediction",
  "type": "object",
  "required": ["schema_version", "engine", "run_id", "document_id", "source_page_number_1based", "elements", "tables"],
  "properties": {
    "schema_version": {"const": 1},
    "engine": {"type": "string"},
    "run_id": {"type": "string"},
    "document_id": {"type": "string"},
    "source_page_number_1based": {"type": "integer", "minimum": 1},
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["order", "text", "label", "bbox_norm"],
        "properties": {
          "order": {"type": "integer", "minimum": 0},
          "text": {"type": "string"},
          "label": {"enum": ["text", "title", "figure", "other"]},
          "bbox_norm": {"$ref": "#/$defs/bbox"}
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bbox_norm", "columns", "rows"],
        "properties": {
          "bbox_norm": {"$ref": "#/$defs/bbox"},
          "columns": {"type": "array", "items": {"type": "string"}},
          "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}
        }
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "minItems": 4,
      "maxItems": 4
    }
  }
}
