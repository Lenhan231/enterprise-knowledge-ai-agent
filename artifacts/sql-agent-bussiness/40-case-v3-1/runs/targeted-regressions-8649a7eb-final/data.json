      "id": "B40-013",
      "question": "Tại snapshot 2026-11-13, top 5 segment theo tổng units_received; nếu bằng nhau sắp segment tăng dần.",
      "status": "executed",
      "sql": "SELECT commerce.inventory.snapshot_date AS snapshot_date, commerce.inventory.segment AS segment, SUM(commerce.inventory.units_received) AS units_received FROM commerce.inventory JOIN commerce.products ON inventory.product_id = products.product_id WHERE commerce.inventory.snapshot_date = $1 GROUP BY commerce.inventory.snapshot_date, commerce.inventory.segment ORDER BY SUM(commerce.inventory.units_received) DESC NULLS LAST, commerce.inventory.snapshot_date, commerce.inventory.segment LIMIT 5",
