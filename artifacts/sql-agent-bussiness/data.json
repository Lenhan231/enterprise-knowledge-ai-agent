    {
      "id": "P03",
      "question": "Top 5 products by units sold from delivered orders between 2025-04-01 and 2025-06-30; return product_id and units, ties by product_id ascending.",
      "status": "executed",
      "sql": "WITH sales_cte AS (SELECT oi.product_id AS product_id, SUM(oi.quantity) AS units FROM commerce.order_items AS oi JOIN commerce.orders AS o ON oi.order_id = o.order_id WHERE o.order_date >= $1 AND o.order_date <= $2 AND o.order_status = 'delivered' GROUP BY oi.product_id) SELECT sales_cte.product_id, sales_cte.units FROM sales_cte ORDER BY units DESC, product_id ASC LIMIT 5",
