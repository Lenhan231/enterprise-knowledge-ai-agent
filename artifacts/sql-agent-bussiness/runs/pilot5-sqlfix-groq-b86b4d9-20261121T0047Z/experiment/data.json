      "sql": "SELECT oi.product_id AS product_id, SUM(oi.quantity) AS units\nFROM commerce.order_items AS oi\nJOIN commerce.orders AS o ON oi.order_id = o.order_id\nWHERE o.order_status = $1\n  AND o.order_date >= CAST($2 AS DATE)\n  AND o.order_date <= CAST($3 AS DATE)\nGROUP BY oi.product_id\nORDER BY units DESC, product_id ASC\nLIMIT 5",
