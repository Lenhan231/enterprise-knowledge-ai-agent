    {
      "id": "P03",
      "question": "Top 5 products by units sold from delivered orders between 2025-04-01 and 2025-06-30; return product_id and units, ties by product_id ascending.",
      "status": "executed",
      "sql": "WITH delivered AS (\n  SELECT oi.product_id, SUM(oi.quantity) AS units\n  FROM commerce.order_items AS oi\n  JOIN commerce.orders AS o ON oi.order_id = o.order_id\n  WHERE o.order_status = 'delivered'\n    AND o.order_date >= $1\n    AND o.order_date <= $2\n  GROUP BY oi.product_id\n)\nSELECT d.product_id, d.units\nFROM delivered AS d\nORDER BY d.units DESC, d.product_id ASC\nLIMIT 5;",
      "parameters": [
