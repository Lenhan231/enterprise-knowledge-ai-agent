{
  "report_type": "inventory_operations",
  "title": "Inventory & Operations Report",
  "schema_version": "1.0.0",
  "source_contract": "commerce_schema_metric_contract_v1.md",
  "strict_generation_rules": {
    "template_structure": "IMMUTABLE",
    "metric_catalog": "IMMUTABLE",
    "dashboard_layout": "IMMUTABLE",
    "decision_rule_catalog": "IMMUTABLE",
    "llm_role": "Select report_type and scope; populate only value, series data, evidence, data_quality fields from approved agent outputs. Never create/delete/rename metrics, charts, sections, or rules.",
    "allowed_runtime_mutations": [
      "request.period.start",
      "request.period.end_exclusive",
      "request.granularity",
      "request.dimension",
      "request.dimension_value",
      "metrics.*.value",
      "metrics.*.status",
      "metrics.*.evidence",
      "dashboard.widgets.*.data",
      "decisions.*.triggered",
      "decisions.*.evidence",
      "data_quality.*"
    ],
    "forbidden": [
      "Invent metrics, narratives, dashboard charts, thresholds or unsupported breakdowns",
      "Assume currency for synthetic commerce data",
      "Infer causality from correlation",
      "Join commerce.sales with order_items/orders to allocate sales by category/region",
      "Combine commerce.invoices with synthetic commerce sales",
      "Reinterpret inventory snapshots as daily movements",
      "Use missing/undefined numeric data as zero",
      "Bypass SQL allowlist, RBAC or document RLS",
      "Treat synthetic demo data as real company performance"
    ],
    "authorization": "Each upstream tool call must be authorized for requester; no cross-role inference or fallback to service-role results.",
    "calculation_policy": "SQL Agent calculates fixed metric formulas; Report Agent only copies validated results; no LLM arithmetic.",
    "null_policy": "If unavailable/unsupported/ambiguous, value=null; status=not_available or unresolved; omit unsupported conclusions without changing structure.",
    "period_policy": "Use [start,end_exclusive) for DATE comparisons. Year means calendar year; latest means latest observed source date. Record coverage separately.",
    "dimension_policy": "Validate requested dimension against each metric's allowed_dimensions; unsupported combinations return not_available rather than approximate.",
    "output_policy": "Output JSON only. Fixed key set and order. No Markdown. No new fields. Dashboard uses fixed widget ids/types/order. Decisions use deterministic triggers only."
  },
  "request": {
    "period": {
      "start": null,
      "end_exclusive": null
    },
    "granularity": "month",
    "dimension": "all",
    "dimension_value": null
  },
  "data_quality": {
    "coverage_start": null,
    "coverage_end": null,
    "partial_period": null,
    "missing_or_unmatched_count": null,
    "limitations": []
  },
  "metric_value_shape": {
    "value": null,
    "status": "pending",
    "evidence": []
  },
  "evidence_shape": {
    "source_table": "",
    "query_id": "",
    "filters": {},
    "row_count": null,
    "document_id": null,
    "citation": null
  },
  "permitted_statuses": [
    "pending",
    "available",
    "no_data",
    "not_available",
    "unresolved",
    "access_denied"
  ],
  "supported_request": {
    "dimensions": [
      "all",
      "category",
      "segment",
      "product"
    ],
    "granularities": [
      "snapshot",
      "month",
      "quarter",
      "year"
    ]
  },
