        "overstock_products"
      ],
      "triggered": null,
      "evidence": [],
      "priority": "fixed_rule_order",
      "status": "pending"
    },
    {
      "id": "I04",
      "title": "No inventory flags",
      "condition": "stockout_products = 0 AND reorder_products = 0 AND overstock_products = 0 AND complete snapshot coverage",
      "action": "No flagged inventory exception in observed snapshot",
      "required_metric_ids": [
        "stockout_products",
        "reorder_products",
        "overstock_products"
      ],
      "triggered": null,
      "evidence": [],
      "priority": "fixed_rule_order",
      "status": "pending"
    }
  ],
