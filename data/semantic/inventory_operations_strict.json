    "operations_summary",
    "snapshot_scorecard",
    "product_risks",
    "fulfillment_and_returns",
    "policy_evidence",
    "fixed_decisions",
    "data_quality"
  ],
  "agent_dependencies": [
    "sql",
    "knowledge",
    "dashboard"
  ],
  "metrics": [
    {
      "id": "observed_products",
      "label": "Observed inventory products",
      "source": "commerce.inventory",
      "formula": "COUNT(DISTINCT product_id) at selected latest snapshot <= period end",
      "allowed_dimensions": [
        "all",
        "category",
        "segment",
        "product"
      ],
      "scope": "",
      "unit": "products",
      "grain": "snapshot",
      "value": null,
      "status": "pending",
      "evidence": [],
      "notes": null
    },
    {
      "id": "stock_on_hand",
      "label": "Total stock on hand",
      "source": "commerce.inventory",
      "formula": "SUM(stock_on_hand) at one selected snapshot",
      "allowed_dimensions": [
        "all",
        "category",
        "segment",
        "product"
      ],
      "scope": "",
      "unit": "units",
      "grain": "snapshot",
      "value": null,
      "status": "pending",
      "evidence": [],
      "notes": null
    },
    {
      "id": "stockout_products",
      "label": "Stockout flagged products",
      "source": "commerce.inventory",
      "formula": "COUNT(*) FILTER (WHERE stockout_flag=true) at one selected snapshot",
      "allowed_dimensions": [
        "all",
        "category",
        "segment",
        "product"
      ],
      "scope": "",
      "unit": "products",
      "grain": "snapshot",
      "value": null,
      "status": "pending",
      "evidence": [],
      "notes": null
    },
    {
      "id": "stockout_flag_pct",
      "label": "Observed stockout flag share",
      "source": "commerce.inventory",
      "formula": "100*stockout_products/NULLIF(observed_products,0)",
      "allowed_dimensions": [
        "all",
        "category",
        "segment",
        "product"
      ],
      "scope": "",
      "unit": "percent",
      "grain": "snapshot",
      "value": null,
      "status": "pending",
      "evidence": [],
      "notes": "Not the same as stock_on_hand=0"
    },
    {
      "id": "overstock_products",
      "label": "Overstock flagged products",
      "source": "commerce.inventory",
      "formula": "COUNT(*) FILTER (WHERE overstock_flag=true) at one selected snapshot",
      "allowed_dimensions": [
        "all",
        "category",
        "segment",
        "product"
      ],
      "scope": "",
      "unit": "products",
      "grain": "snapshot",
      "value": null,
      "status": "pending",
      "evidence": [],
      "notes": null
    },
    {
      "id": "reorder_products",
      "label": "Reorder flagged products",
      "source": "commerce.inventory",
      "formula": "COUNT(*) FILTER (WHERE reorder_flag=true) at one selected snapshot",
      "allowed_dimensions": [
        "all",
        "category",
        "segment",
        "product"
      ],
      "scope": "",
      "unit": "products",
      "grain": "snapshot",
      "value": null,
      "status": "pending",
      "evidence": [],
      "notes": null
    },
    {
      "id": "returned_order_count",
      "label": "Returned orders",
      "source": "commerce.returns",
      "formula": "COUNT(DISTINCT returns.order_id) by return_date window",
      "allowed_dimensions": [
        "all"
      ],
      "scope": "",
      "unit": "orders",
      "grain": "return_event",
      "value": null,
      "status": "pending",
      "evidence": [],
      "notes": null
    },
    {
      "id": "avg_delivery_days",
      "label": "Average shipment duration",
      "source": "commerce.shipments + commerce.orders",
      "formula": "AVG(delivery_date - ship_date) for rows with both dates",
      "allowed_dimensions": [
        "all"
      ],
      "scope": "",
      "unit": "calendar_days",
      "grain": "shipment",
      "value": null,
      "status": "pending",
      "evidence": [],
      "notes": "Filter via ship_date; no promised SLA in database"
    },
    {
      "id": "avg_review_rating",
      "label": "Average review rating",
      "source": "commerce.reviews",
      "formula": "AVG(rating)",
      "allowed_dimensions": [
        "all",
        "category",
        "product"
      ],
      "scope": "",
      "unit": "rating_1_to_5",
      "grain": "reviews",
      "value": null,
      "status": "pending",
      "evidence": [],
      "notes": "Filter by review_date; avoid representativeness claims"
    }
  ],
  "dashboard": {
    "layout": "fixed",
    "columns": 2,
    "widgets": [
      {
        "id": "inventory_kpis",
        "type": "kpi_row",
        "title": "Current inventory status",
        "metric_ids": [
          "observed_products",
          "stock_on_hand",
          "stockout_products",
          "reorder_products"
        ],
        "x_dimension": "period",
        "data": [],
        "notes": ""
      },
      {
        "id": "inventory_flag_distribution",
        "type": "bar",
        "title": "Flagged SKUs by category",
        "metric_ids": [
          "stockout_products",
          "overstock_products",
          "reorder_products"
        ],
        "x_dimension": "category",
        "data": [],
        "notes": "Fixed three flag series; counts may overlap"
      },
      {
        "id": "stockout_product_table",
        "type": "table",
        "title": "Stockout product list",
        "metric_ids": [
          "stockout_products"
        ],
        "x_dimension": "product",
        "data": [],
        "notes": "Rows are only source-observed SKU snapshot records; observe validator output cap"
      },
      {
        "id": "operations_kpis",
        "type": "kpi_row",
        "title": "Fulfillment and experience",
        "metric_ids": [
          "avg_delivery_days",
          "returned_order_count",
          "avg_review_rating"
        ],
        "x_dimension": "period",
        "data": [],
        "notes": ""
      },
      {
        "id": "inventory_snapshots",
        "type": "line",
        "title": "Stockout-flag count by snapshot",
        "metric_ids": [
          "stockout_products"
        ],
        "x_dimension": "snapshot_date",
        "data": [],
        "notes": "Evaluate each snapshot independently, never sum across dates"
      }
    ]
  },
  "decisions": [
    {
      "id": "I01",
      "title": "Observed stockout flags",
      "condition": "stockout_products > 0",
      "action": "Investigate flagged SKUs; policy compliance conclusion requires cited approved policy",
      "required_metric_ids": [
        "stockout_products"
      ],
      "triggered": null,
      "evidence": [],
      "priority": "fixed_rule_order",
      "status": "pending"
    },
    {
      "id": "I02",
      "title": "Observed reorder flags",
      "condition": "reorder_products > 0",
      "action": "Review flagged SKUs against the approved reorder procedure; do not infer lead time or order quantity",
      "required_metric_ids": [
        "reorder_products"
      ],
      "triggered": null,
      "evidence": [],
      "priority": "fixed_rule_order",
      "status": "pending"
    },
    {
      "id": "I03",
      "title": "Observed overstock flags",
      "condition": "overstock_products > 0",
      "action": "Inspect flagged overstock SKUs; do not infer carrying costs",
