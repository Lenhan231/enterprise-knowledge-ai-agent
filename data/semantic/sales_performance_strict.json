  "decisions": [
    {
      "id": "S01",
      "title": "Revenue decline",
      "condition": "company_revenue_change_pct < 0 AND both periods have sufficient coverage",
      "action": "Review company-level revenue trend and investigate; do not assert cause",
      "required_metric_ids": [
        "company_revenue_change_pct"
      ],
      "triggered": null,
      "evidence": [],
      "priority": "fixed_rule_order",
      "status": "pending"
    },
    {
      "id": "S02",
      "title": "Nonpositive gross profit",
      "condition": "company_gross_profit <= 0 AND company_revenue > 0",
      "action": "Review company-level COGS and pricing conditions",
      "required_metric_ids": [
        "company_gross_profit",
        "company_revenue"
      ],
      "triggered": null,
      "evidence": [],
      "priority": "fixed_rule_order",
      "status": "pending"
    },
    {
      "id": "S03",
      "title": "Positive revenue with negative profit trend",
      "condition": "company_revenue_change_pct > 0 AND gross_profit_current < gross_profit_prior AND comparable coverage",
      "action": "Investigate increased cost pressure; avoid causal claims",
      "required_metric_ids": [
        "company_revenue_change_pct",
        "company_gross_profit"
      ],
      "triggered": null,
      "evidence": [],
      "priority": "fixed_rule_order",
      "status": "pending"
    },
    {
      "id": "S04",
      "title": "No decision trigger",
      "condition": "none of S01-S03 triggered and required metrics available",
      "action": "No predefined risk trigger; do not assert business health",
      "required_metric_ids": [
