  "metrics": [
    {
      "id": "company_revenue",
      "label": "Company revenue",
      "source": "commerce.sales",
      "formula": "SUM(revenue)",
      "allowed_dimensions": [
        "all"
      ],
      "scope": "",
      "unit": "unknown_currency_amount",
      "grain": "daily_company",
      "value": null,
      "status": "pending",
      "evidence": [],
      "notes": null
    },
    {
      "id": "company_cogs",
      "label": "Company COGS",
      "source": "commerce.sales",
      "formula": "SUM(cogs)",
      "allowed_dimensions": [
        "all"
      ],
      "scope": "",
      "unit": "unknown_currency_amount",
      "grain": "daily_company",
      "value": null,
      "status": "pending",
      "evidence": [],
      "notes": null
    },
    {
      "id": "company_gross_profit",
      "label": "Company gross profit",
      "source": "commerce.sales",
      "formula": "SUM(revenue)-SUM(cogs)",
      "allowed_dimensions": [
        "all"
      ],
      "scope": "",
      "unit": "unknown_currency_amount",
      "grain": "daily_company",
      "value": null,
      "status": "pending",
      "evidence": [],
      "notes": null
    },
    {
      "id": "company_gross_margin_pct",
      "label": "Company gross margin",
      "source": "commerce.sales",
      "formula": "100*(SUM(revenue)-SUM(cogs))/NULLIF(SUM(revenue),0)",
      "allowed_dimensions": [
        "all"
      ],
      "scope": "",
      "unit": "percent",
      "grain": "daily_company",
      "value": null,
      "status": "pending",
      "evidence": [],
      "notes": "Derived ratio of defined company-level aggregates; NULL for zero denominator"
    },
    {
      "id": "company_revenue_change_pct",
      "label": "Company revenue period-over-period change",
      "source": "commerce.sales",
      "formula": "100*(revenue_current-revenue_prior)/NULLIF(revenue_prior,0)",
      "allowed_dimensions": [
        "all"
      ],
      "scope": "",
      "unit": "percent",
      "grain": "comparable_periods",
      "value": null,
      "status": "pending",
      "evidence": [],
      "notes": "Same length/comparable calendar period; set unavailable if prior coverage insufficient"
    },
    {
      "id": "order_count",
      "label": "Order count",
      "source": "commerce.orders",
      "formula": "COUNT(DISTINCT order_id)",
      "allowed_dimensions": [
        "all",
        "region",
        "order_source"
      ],
      "scope": "",
      "unit": "orders",
      "grain": "orders",
      "value": null,
      "status": "pending",
      "evidence": [],
      "notes": "No implicit status filter"
    },
    {
      "id": "delivered_line_revenue",
      "label": "Delivered order-line revenue",
      "source": "commerce.order_items + commerce.orders",
      "formula": "SUM(quantity*unit_price-discount_amount) WHERE orders.order_status = delivered",
      "allowed_dimensions": [
        "all",
        "category",
        "region",
        "product",
        "order_source"
      ],
      "scope": "",
      "unit": "unknown_currency_amount",
      "grain": "order_items",
      "value": null,
      "status": "pending",
      "evidence": [],
      "notes": "Never reconcile or mix with company_revenue; aggregate by order_date and approved joins"
    },
    {
      "id": "delivered_average_order_value",
      "label": "Delivered AOV",
      "source": "commerce.order_items + commerce.orders",
      "formula": "delivered_line_revenue / NULLIF(COUNT(DISTINCT delivered orders.order_id),0)",
      "allowed_dimensions": [
        "all",
        "category",
        "region",
        "product",
        "order_source"
      ],
      "scope": "",
      "unit": "unknown_currency_amount_per_order",
      "grain": "order_population",
      "value": null,
      "status": "pending",
      "evidence": [],
      "notes": "If dimension product/category, denominator is delivered orders containing that dimension; not company-level AOV"
    },
    {
      "id": "promotion_discount",
      "label": "Order-line discount total",
      "source": "commerce.order_items + commerce.orders",
      "formula": "SUM(discount_amount)",
      "allowed_dimensions": [
        "all",
        "category",
        "region",
        "product",
        "order_source"
      ],
      "scope": "",
      "unit": "unknown_currency_amount",
      "grain": "order_items",
      "value": null,
      "status": "pending",
      "evidence": [],
      "notes": "Descriptive discount only, not promotion ROI"
    },
    {
      "id": "sessions",
      "label": "Web sessions",
      "source": "commerce.web_traffic",
      "formula": "SUM(sessions)",
      "allowed_dimensions": [
        "all"
      ],
      "scope": "",
      "unit": "sessions",
      "grain": "date_traffic_source",
      "value": null,
      "status": "pending",
      "evidence": [],
      "notes": "Do not infer conversion/attribution to orders"
    }
