FROM python:3.11-slim
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgomp1 tesseract-ocr tesseract-ocr-eng tesseract-ocr-vie \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir \
    "docling==2.129.0" "opencv-python-headless"

COPY src/document_processing ./src/document_processing

ENV PYTHONPATH="/app/src" \
    PYTHONUNBUFFERED="1"

CMD ["python", "-c", "from docling.document_converter import DocumentConverter; from document_processing.document_processor import DocumentProcessor; print('PASS: Docling and document_processing imports')"]
