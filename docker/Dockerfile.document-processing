FROM python:3.11-slim
WORKDIR /app
RUN python -m pip install --no-cache-dir uv==0.12.15
COPY pyproject.toml uv.lock ./
RUN uv export --locked --no-dev --no-hashes --no-emit-project --extra docling --output-file /constraints.txt > /dev/null
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 libgl1 libglib2.0-0 tesseract-ocr tesseract-ocr-eng tesseract-ocr-osd tesseract-ocr-vie && rm -rf /var/lib/apt/lists/*
RUN uv venv && uv pip install --no-cache --torch-backend cpu -c /constraints.txt fastapi uvicorn docling opencv-python-headless "rapidocr==3.9.2" "onnxruntime>=1.18,<2" "albumentations==1.4.2" "einops==0.2.0" "gdown==4.4.0" "prefetch-generator==1.0.1" "imgaug==0.4.0" "lmdb>=1.0.0" "scikit-image>=0.21.0"
# VietOCR pins an older Pillow; retain the project Pillow version shared with Docling.
RUN uv pip install --no-cache --no-deps "vietocr==0.3.13"
# gdown 4.4 imports pkg_resources, removed from setuptools 82.
RUN uv pip install --no-cache --no-deps "setuptools<81"
RUN uv pip install --no-cache -c /constraints.txt pymupdf
RUN .venv/bin/python -c "import cv2; from docling.document_converter import DocumentConverter; from vietocr.tool.predictor import Predictor"
COPY src ./src
ENV PATH="/app/.venv/bin:$PATH" PYTHONPATH="/app/src" PYTHONUNBUFFERED="1" HF_HOME="/models"
EXPOSE 8000
ENV DOCUMENT_PROCESSING_OCR_ENGINE="vietocr"
ENV SERVICE_KIND="document-processing" EMBEDDING_BACKEND="local" RERANKER_ALLOW_DOWNLOAD="1"
CMD ["uvicorn", "core.services.runtime:app", "--host", "0.0.0.0", "--port", "8000"]
