FROM python:3.11-slim
WORKDIR /app
RUN python -m pip install --no-cache-dir uv==0.12.15
COPY pyproject.toml uv.lock ./
RUN uv export --locked --no-dev --no-hashes --no-emit-project --extra docling --output-file /constraints.txt > /dev/null
RUN uv venv && uv pip install --no-cache --torch-backend cpu -c /constraints.txt fastapi uvicorn python-dotenv langchain-huggingface sentence-transformers
COPY src ./src
ENV PATH="/app/.venv/bin:$PATH" PYTHONPATH="/app/src" PYTHONUNBUFFERED="1" HF_HOME="/models"
EXPOSE 8000
ENV SERVICE_KIND="embeddings" EMBEDDING_BACKEND="local" RERANKER_ALLOW_DOWNLOAD="1"
CMD ["uvicorn", "core.services.runtime:app", "--host", "0.0.0.0", "--port", "8000"]
