FROM python:3.11-slim
WORKDIR /app
RUN python -m pip install --no-cache-dir uv==0.12.15
COPY pyproject.toml uv.lock ./
RUN uv export --locked --no-dev --no-hashes --no-emit-project --extra docling --output-file /constraints.txt > /dev/null
RUN uv venv && uv pip install --no-cache --torch-backend cpu -c /constraints.txt fastapi uvicorn sentence-transformers
# Only what SERVICE_KIND=reranker imports, so unrelated code changes do not rebuild/restart this service
# (and reload its model). tests/test_model_service_images.py fails if an import is added without a COPY here.
COPY src/core/services/__init__.py src/core/services/client.py src/core/services/runtime.py ./src/core/services/
COPY src/core/latency.py ./src/core/
COPY src/core/retrieval/__init__.py src/core/retrieval/reranker.py ./src/core/retrieval/
ENV PATH="/app/.venv/bin:$PATH" PYTHONPATH="/app/src" PYTHONUNBUFFERED="1" HF_HOME="/models"
EXPOSE 8000
ENV SERVICE_KIND="reranker" EMBEDDING_BACKEND="local" RERANKER_ALLOW_DOWNLOAD="1"
CMD ["uvicorn", "core.services.runtime:app", "--host", "0.0.0.0", "--port", "8000"]
